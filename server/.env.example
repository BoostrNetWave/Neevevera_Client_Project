# ==============================================================================
# NEEVEVERA PRIVATE LIMITED — PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# ── 1. Application & Server Runtime ───────────────────────────────────────────
NODE_ENV=production
PORT=5000
CLIENT_URL=https://neevevara.com

# ── 2. Database (MongoDB Atlas) ────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/NeevPvtLtd?retryWrites=true&w=majority

# ── 3. Authentication & Security (JWT) ─────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_64_character_cryptographically_secure_hex_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_second_distinct_64_character_hex_key
JWT_REFRESH_EXPIRES_IN=7d

# ── 4. Cloudinary (Media & Document Uploads) ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=neevevera_upload

# ── 5. Email Notifications (Nodemailer / SMTP) ─────────────────────────────────
# Option A: Standard Gmail with App Password (16 characters)
NODEMAILER_USER=notifications@neevevara.com
NODEMAILER_PASS=your_gmail_app_password
EMAIL_FROM="NEEVEVERA PVT LTD" <notifications@neevevara.com>
ADMIN_EMAIL=inspections@neevevara.com

# Option B: Custom Corporate SMTP (Zoho, Google Workspace, AWS SES, Hostinger)
# SMTP_HOST=smtp.zoho.in
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=notifications@neevevara.com
# SMTP_PASS=your_smtp_password

# ── 6. Razorpay Payment Gateway (Site Visit Booking) ──────────────────────────
# Live credentials from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Secret defined in Razorpay Dashboard > Webhooks > URL: https://neevevara.com/api/razorpay-webhook
RAZORPAY_WEBHOOK_SECRET=your_configured_webhook_secret

# ── 7. Operational Feature Flags ──────────────────────────────────────────────
FEATURE_SERVICE_AREAS=true
FEATURE_PARTNERS=true

